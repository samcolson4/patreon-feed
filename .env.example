# Comma-separated Patreon creator names (the bit after patreon.com/) or full URLs
CREATORS=cgpgrey

# Your Patreon "session_id" cookie, so posts you're subscribed to are unlocked.
# Browser dev tools → Application → Cookies → www.patreon.com → session_id
PATREON_SESSION_ID=

REFRESH_MINUTES=30
POSTS_PER_CREATOR=40
