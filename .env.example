# Comma-separated. Each is a creator name (patreon.com/<name>), creator URL or
# collection URL (patreon.com/collection/<id>). Optional "Label=" prefix sets the button name.
FEEDS=Office Hours Live=https://www.patreon.com/collection/747185,Fin vs History=https://www.patreon.com/collection/1245681

# Your Patreon "session_id" cookie, so posts you're subscribed to are unlocked.
# Browser dev tools → Application → Cookies → www.patreon.com → session_id
PATREON_SESSION_ID=

REFRESH_MINUTES=30
POSTS_PER_FEED=40
